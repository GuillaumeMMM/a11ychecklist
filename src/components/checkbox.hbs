<div class="checkbox-container">
  <div class="checkbox">
    <input type="checkbox" class="mdf-checkbox-field" aria-labelledby="rule-{{#> id}}{{/id}}" />
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 33.6 33.6" class="checkbox-tick" aria-hidden="true">
      <path d="M 9.7999 17.22 L 14 21.4 L 23.8 11.6" fill="none" stroke="currentColor" stroke-width="1.5px"
        stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
    </svg>
  </div>
</div>
<details>
  <summary>
    <h2 class="mdf-title3" id="rule-{{#> id}}{{/id}}">
      {{#> id}}{{/id}}. {{#> title}}{{/title}}
    </h2>
    <svg xmlns="http://www.w3.org/2000/svg" width="1rem" height="1rem" viewBox="0 0 24 24" fill="none" class="arrow">
      <path fill-rule="evenodd" clip-rule="evenodd" fill="currentColor" />
    </svg>
  </summary>
  <div class="details-content">
    {{#> rules}}{{/rules}}
    <div class="section">
      <h3 class="mdf-title4">Pourquoi cette règle ?</h3>
      {{#> whyRule}}{{/whyRule}}
    </div>
    <div class="section">
      <h3 class="mdf-title4">Comment vérifier ?</h3>
      {{#> howToCheck}}{{/howToCheck}}
    </div>
    <div class="section" style="display:{{#> displayGoFurther}}{{/displayGoFurther}}">
      <h3 class="mdf-title4">Aller plus loin</h3>
      {{#> goFurther}}{{/goFurther}}
    </div>
  </div>
</details>